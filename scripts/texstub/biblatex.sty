% Minimal biblatex stub for sandbox draft compiles (no biber available).
% Provides no-op versions of every biblatex command the book uses.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{biblatex}[2026/08/01 draft-compile stub]
\DeclareOption*{}
\ProcessOptions\relax
\newcommand{\addbibresource}[2][]{}
\newcommand{\printbibliography}[1][]{}
\newcommand{\defbibheading}[3][]{}
\newcommand{\DeclareFieldFormat}[3][]{}
\newcommand{\DeclareNameAlias}[2]{}
\newcommand{\AtEveryBibitem}[1]{}
\newcommand{\AtEveryCitekey}[1]{}
\newcommand{\ExecuteBibliographyOptions}[1]{}
\providecommand{\renewbibmacro}{\@ifstar\stub@rbm\stub@rbm}
\def\stub@rbm#1#2{}
\providecommand{\newbibmacro}{\@ifstar\stub@nbm\stub@nbm}
\def\stub@nbm#1#2{}
\newcommand{\printfield}[2][]{}
\newcommand{\usebibmacro}[1]{}
\newcommand{\iffieldundef}[3]{#2}
\renewcommand{\iftoggle}[3]{#3}
\renewcommand{\nocite}[1]{}
\newcommand{\stub@cite}[2][]{[#2]}
\DeclareRobustCommand{\cite}[2][]{[ref]}
\DeclareRobustCommand{\parencite}[2][]{[ref]}
\DeclareRobustCommand{\textcite}[2][]{[ref]}
\newcommand{\footcite}[2][]{}
\newcommand{\fullcite}[2][]{[ref]}
\newcommand{\autocite}[2][]{[ref]}
\DeclareRobustCommand{\citeauthor}[1]{[author]}
\DeclareRobustCommand{\citetitle}{\@ifstar\stub@ct\stub@ct}
\def\stub@ct#1{[title]}
\newcommand{\citeyear}[1]{[year]}
\newcommand{\citedate}[1]{[date]}
\newcommand{\citeurl}[1]{[url]}
\newenvironment{refsection}[1][]{}{}
\newenvironment{refcontext}[1][]{}{}
