\doTocEntry\toclof{}{\csname a:TocLink\endcsname{13}{x13-153011}{}{\numberline {5.3}{\ignorespaces Feasible region and objective level curves for the Lemonade Vendor problem. The shaded polygon is the set of $(x,y)$ satisfying all constraints; dashed lines are level curves $3x+2y = z$ for $z = 0,2,4,6,8$. Sweeping the level curves in the direction of $\nabla z = (3,2)$ shows the optimum is at the vertex $(1.2,1.6)$.\relax }}}{247}\relax 
\doTocEntry\toclof{}{\csname a:TocLink\endcsname{13}{x13-153015}{}{\numberline {5.4}{\ignorespaces Feasible region of a generic linear program with constraints $x_1+x_2\geq 3$, $2x_1-x_2\leq 5$, and $-x_1+2x_2\leq 3$. The shaded triangle illustrates how three linear inequalities can carve out a bounded polygonal region.\relax }}}{250}\relax 
